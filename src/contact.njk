---
layout: base.njk
title: "Contact DHS Multispecialty Hospital Ahmedabad — Appointment & Emergency"
description: "Contact DHS Multispecialty Hospital, Gurukul, Ahmedabad. 24/7 Emergency: +91 9081610444. Book appointments, get directions, or reach our billing department."
canonical: "https://dhshospitals.com/contact/"
activePage: "contact"
---

<div class="page-banner">
  <div class="container">
    <h1>Contact Us</h1>
    <div class="breadcrumb"><a href="/">Home</a> / Contact Us</div>
  </div>
</div>

<section class="content-section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <h3>Get In Touch</h3>
        <div class="info-item">
          <span class="info-label">Address:</span>
          <span>{{ site.address.full }}</span>
        </div>
        <div class="info-item">
          <span class="info-label">Emergency:</span>
          <span><a href="tel:{{ site.phones.emergency }}">{{ site.phones.emergency }}</a> (24x7)</span>
        </div>
        <div class="info-item">
          <span class="info-label">Landline:</span>
          <span>{{ site.phones.landline1 }} / {{ site.phones.landline2 }}</span>
        </div>
        <div class="info-item">
          <span class="info-label">Billing:</span>
          <span><a href="tel:{{ site.phones.billing }}">{{ site.phones.billing }}</a></span>
        </div>
        <div class="info-item">
          <span class="info-label">Email:</span>
          <span><a href="mailto:{{ site.email }}">{{ site.email }}</a></span>
        </div>
        <div class="info-item">
          <span class="info-label">Visiting:</span>
          <span>{{ site.visiting_hours }}</span>
        </div>
        <div style="margin-top:20px">
          <a href="{{ site.whatsapp_link }}" target="_blank" rel="noopener" class="btn btn-accent">WhatsApp Us</a>
          <a href="{{ site.google_maps_link }}" target="_blank" rel="noopener" class="btn btn-outline" style="margin-left:10px">Get Directions</a>
        </div>
      </div>
      <div>
        <h3 style="color:var(--primary);margin-bottom:15px">Send Message</h3>
        <form action="https://formsubmit.co/{{ site.email }}" method="POST">
          <input type="hidden" name="_subject" value="Contact from DHS Hospital Website">
          <input type="hidden" name="_captcha" value="false">
          <div class="form-row">
            <div class="form-group">
              <label>Name</label>
              <input type="text" name="name" required>
            </div>
            <div class="form-group">
              <label>Email</label>
              <input type="email" name="email" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Phone</label>
              <input type="tel" name="phone">
            </div>
            <div class="form-group">
              <label>Subject</label>
              <input type="text" name="subject">
            </div>
          </div>
          <div class="form-group">
            <label>Your Message</label>
            <textarea name="message" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Send Message</button>
        </form>
      </div>
    </div>
    <div class="map-container">
      <iframe src="{{ site.google_maps_embed }}" allowfullscreen loading="lazy" title="DHS Multispecialty Hospital Location Map"></iframe>
    </div>
  </div>
</section>
