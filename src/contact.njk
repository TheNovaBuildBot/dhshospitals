---
layout: base.njk
title: "Ahmedabad DHS Hospital Contact | 24/7 Emergency Care"
description: "Ahmedabad's DHS Multispecialty Hospital: call our 24/7 emergency line, book an OPD appointment, or get directions to our NABH-accredited Gurukul campus."
canonical: "https://www.dhshospitals.com/contact/"
breadcrumbs:
  - { name: "Home", url: "/" }
  - { name: "Contact Us", url: "/contact/" }
activePage: "contact"
---

<div class="page-banner">
  <div class="container">
    <h1>Contact Us</h1>
    <div class="breadcrumb"><a href="/">Home</a> / Contact Us</div>
  </div>
</div>

<section class="content-section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <h3>Get In Touch</h3>
        <div class="info-item">
          <span class="info-label">Address:</span>
          <span>{{ site.address.full }}</span>
        </div>
        <div class="info-item">
          <span class="info-label">Emergency:</span>
          <span><a href="tel:{{ site.phones.emergency }}">{{ site.phones.emergency }}</a> (24x7)</span>
        </div>
        <div class="info-item">
          <span class="info-label">Landline:</span>
          <span>{{ site.phones.landline1 }} / {{ site.phones.landline2 }}</span>
        </div>
        <div class="info-item">
          <span class="info-label">Billing:</span>
          <span><a href="tel:{{ site.phones.billing }}">{{ site.phones.billing }}</a></span>
        </div>
        <div class="info-item">
          <span class="info-label">Email:</span>
          <span><a href="mailto:{{ site.email }}">{{ site.email }}</a></span>
        </div>
        <div class="info-item">
          <span class="info-label">Visiting:</span>
          <span>{{ site.visiting_hours }}</span>
        </div>
        <div style="margin-top:20px">
          <a href="{{ site.whatsapp_link }}" target="_blank" rel="noopener" class="btn btn-accent">WhatsApp Us</a>
          <a href="{{ site.google_maps_link }}" target="_blank" rel="noopener" class="btn btn-outline" style="margin-left:10px">Get Directions</a>
        </div>
      </div>
      <div>
        <h3 style="color:var(--primary);margin-bottom:15px">Send Message</h3>
        <div id="contact-sent" role="status" style="display:none;background:#e7f4ec;border:1px solid #bfe3cd;color:#1c6b3f;padding:12px 16px;border-radius:8px;margin-bottom:16px">
          Thank you &mdash; your message has been sent. Our team will be in touch shortly.
        </div>
        <form action="https://hub.novabuildbot.com/contact/21" method="POST">
          <!-- Honeypot: hidden from people, tempting to bots. Filled = dropped. -->
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
          <div class="form-row">
            <div class="form-group">
              <label for="contact-name">Name <span aria-label="required">*</span></label>
              <input type="text" name="name" id="contact-name" required aria-required="true" autocomplete="name">
            </div>
            <div class="form-group">
              <label for="contact-email">Email <span aria-label="required">*</span></label>
              <input type="email" name="email" id="contact-email" required aria-required="true" autocomplete="email">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="contact-phone">Phone</label>
              <input type="tel" name="phone" id="contact-phone" autocomplete="tel">
            </div>
            <div class="form-group">
              <label for="contact-subject">Subject</label>
              <input type="text" name="subject" id="contact-subject">
            </div>
          </div>
          <div class="form-group">
            <label for="contact-message">Your Message</label>
            <textarea name="message" id="contact-message" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Send Message</button>
        </form>
        <script>if(location.search.indexOf('sent=1')>-1){var b=document.getElementById('contact-sent');if(b){b.style.display='block';b.scrollIntoView({block:'center'});}}</script>
      </div>
    </div>
    <div class="map-container">
      <iframe src="{{ site.google_maps_embed }}" allowfullscreen loading="lazy" title="DHS Multispecialty Hospital Location Map"></iframe>
    </div>
  </div>
</section>
