---
pagination:
  data: departments
  size: 1
  alias: dept
permalink: "departments/{{ dept.slug }}/"
layout: base.njk
eleventyComputed:
  title: "{{ dept.name }} in Ahmedabad — DHS Multispecialty Hospital"
  description: "{{ dept.short_desc }} Expert {{ dept.name }} treatment at DHS Multispecialty Hospital, Ahmedabad. Book consultation today."
  canonical: "https://www.dhshospitals.com/departments/{{ dept.slug }}/"
  og_image: "https://www.dhshospitals.com{{ dept.image }}"
  og_image_alt: "{{ dept.name }} department at DHS Multispecialty Hospital Ahmedabad"
  breadcrumbs:
    - { name: "Home", url: "/" }
    - { name: "Departments", url: "/departments/" }
    - { name: "{{ dept.name }}", url: "/departments/{{ dept.slug }}/" }
  pageSchema: |
    {
      "@type": "MedicalClinic",
      "@id": "https://www.dhshospitals.com/departments/{{ dept.slug }}/#clinic",
      "name": "{{ dept.name }} — DHS Multispecialty Hospital",
      "url": "https://www.dhshospitals.com/departments/{{ dept.slug }}/",
      "image": "https://www.dhshospitals.com{{ dept.image }}",
      "description": "{{ dept.short_desc }}",
      "parentOrganization": { "@id": "https://www.dhshospitals.com/#hospital" },
      "areaServed": [
        { "@type": "City", "name": "Ahmedabad" },
        { "@type": "AdministrativeArea", "name": "Gujarat" }
      ],
      "medicalSpecialty": "{{ dept.name }}",
      "availableService": [
        {%- if dept.services %}{% for service in dept.services %}
        { "@type": "MedicalProcedure", "name": "{{ service }}" }{% if not loop.last %},{% endif %}{% endfor %}{%- endif %}
      ]
    }
activePage: "departments"
---

<div class="page-banner">
  <div class="container">
    <h1>{{ dept.name }} in Ahmedabad</h1>
    <div class="breadcrumb"><a href="/">Home</a> / <a href="/departments/">Departments</a> / {{ dept.name }}</div>
  </div>
</div>

<section class="content-section">
  <div class="container">
    <div class="dept-detail-header">
      <div>
        <h2 style="color:var(--primary);margin-bottom:15px">About the {{ dept.name }} Department</h2>
        <p>{{ dept.full_desc }}</p>
        {% if dept.services and dept.services.length %}
        <h3 style="color:var(--primary);margin-top:25px;margin-bottom:15px">{{ dept.name }} Services & Treatments at DHS</h3>
        <ul class="services-list">
          {% for service in dept.services %}
          <li>{{ service }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
      <div>
        <img src="{{ dept.image }}" alt="{{ dept.name }} department at DHS Hospital Ahmedabad" loading="lazy" width="600" height="400">
      </div>
    </div>

    {% if dept.doctors and dept.doctors.length %}
    <h3 style="color:var(--primary);margin:30px 0 20px">Meet our {{ dept.name }} Specialists in Ahmedabad</h3>
    <div class="doctors-grid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">
      {% for docSlug in dept.doctors %}
      {% for doc in doctors %}
      {% if doc.slug == docSlug %}
      <a href="/doctors/{{ doc.slug }}/" class="doctor-card" style="text-decoration:none;color:inherit">
        <img src="{{ doc.image }}" alt="{{ doc.name }}" loading="lazy" width="300" height="250">
        <div class="doctor-card-body">
          <h3>{{ doc.name }}</h3>
          <div class="qualification">{{ doc.qualification }}</div>
        </div>
      </a>
      {% endif %}
      {% endfor %}
      {% endfor %}
    </div>
    {% endif %}

    {% if deptFaqs[dept.slug] %}
    <div class="faq-section" style="margin-top:50px">
      <h2 style="color:var(--primary);margin-bottom:20px">{{ dept.name }} — Frequently Asked Questions</h2>
      {% for item in deptFaqs[dept.slug] %}
      <details class="faq-item">
        <summary>{{ item.q }}</summary>
        <div class="faq-answer">{{ item.a }}</div>
      </details>
      {% endfor %}
    </div>
    {% endif %}

    <div style="margin-top:40px;text-align:center;padding:30px;background:var(--primary-light);border-radius:var(--radius)">
      <h3 style="color:var(--primary);margin-bottom:10px">Book a {{ dept.name }} Consultation in Ahmedabad</h3>
      <p style="margin-bottom:15px;color:var(--text-light)">Speak to our {{ dept.name }} specialists at DHS Multispecialty Hospital today.</p>
      <a href="/appointment/" class="btn btn-primary">Book Appointment</a>
      <a href="tel:{{ site.phones.emergency }}" class="btn btn-outline" style="margin-left:10px">Call {{ site.phones.emergency }}</a>
    </div>
  </div>
</section>
