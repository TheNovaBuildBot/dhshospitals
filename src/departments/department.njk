---
pagination:
  data: departments
  size: 1
  alias: dept
permalink: "departments/{{ dept.slug }}/"
layout: base.njk
eleventyComputed:
  title: "{{ dept.title or (dept.name + ' in Ahmedabad — DHS Hospital') }}"
  description: "{{ dept.meta_description or (dept.name + ' at DHS Multispecialty Hospital, Ahmedabad. ' + dept.short_desc) }}"
  canonical: "{% if dept.slug == 'robotic-surgery' %}https://www.dhshospitals.com/velys-robotic-knee-replacement-ahmedabad/{% else %}https://www.dhshospitals.com/departments/{{ dept.slug }}/{% endif %}"
  og_image: "https://www.dhshospitals.com{{ dept.image }}"
  og_image_alt: "{{ dept.name }} department at DHS Multispecialty Hospital Ahmedabad"
  breadcrumbs:
    - { name: "Home", url: "/" }
    - { name: "Departments", url: "/departments/" }
    - { name: "{{ dept.name }}", url: "/departments/{{ dept.slug }}/" }
  pageSchema: |
    {
      "@type": "MedicalClinic",
      "@id": "https://www.dhshospitals.com/departments/{{ dept.slug }}/#clinic",
      "name": "{{ dept.name }} — DHS Multispecialty Hospital",
      "url": "https://www.dhshospitals.com/departments/{{ dept.slug }}/",
      "image": "https://www.dhshospitals.com{{ dept.image }}",
      "description": "{{ dept.short_desc }}",
      "parentOrganization": { "@id": "https://www.dhshospitals.com/#hospital" },
      "areaServed": [
        { "@type": "City", "name": "Ahmedabad" },
        { "@type": "AdministrativeArea", "name": "Gujarat" }
      ],
      "medicalSpecialty": "{{ dept.name }}",
      "availableService": [
        {%- if dept.services %}{% for service in dept.services %}
        { "@type": "MedicalProcedure", "name": "{{ service }}" }{% if not loop.last %},{% endif %}{% endfor %}{%- endif %}
      ]
    }
activePage: "departments"
---

<div class="page-banner">
  <div class="container">
    <h1>{% if dept.slug == 'orthopedics' %}Advanced Orthopedic &amp; Robotic Knee Care at DHS Hospital{% else %}{{ dept.name }} in Ahmedabad{% endif %}</h1>
    <div class="breadcrumb"><a href="/">Home</a> / <a href="/departments/">Departments</a> / {{ dept.name }}</div>
  </div>
</div>

<section class="content-section">
  <div class="container">
    <div class="dept-intro">
      <h2 class="dept-intro-heading">About the {{ dept.name }} Department</h2>
      <img class="dept-intro-image" src="{{ dept.image }}" alt="{{ dept.name }} department at DHS Hospital Ahmedabad" loading="lazy" width="600" height="400">
      {% for paragraph in dept.full_desc.split("\n\n") %}
      <p>{{ paragraph }}</p>
      {% endfor %}
    </div>

    {% if dept.services and dept.services.length %}
    <h3 class="dept-services-heading">{{ dept.name }} Services & Treatments at DHS</h3>
    <ul class="services-list">
      {% for service in dept.services %}
      <li>{{ service }}</li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if dept.doctors and dept.doctors.length %}
    <h3 style="color:var(--primary);margin:30px 0 20px">Meet our {{ dept.name }} Specialists in Ahmedabad</h3>
    <div class="doctors-grid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">
      {% for docSlug in dept.doctors %}
      {% for doc in doctors %}
      {% if doc.slug == docSlug %}
      <a href="/doctors/{{ doc.slug }}/" class="doctor-card" style="text-decoration:none;color:inherit">
        <img src="{{ doc.image }}" alt="{{ doc.name }}" loading="lazy" width="300" height="250">
        <div class="doctor-card-body">
          <h3>{{ doc.name }}</h3>
          <div class="qualification">{{ doc.qualification }}</div>
        </div>
      </a>
      {% endif %}
      {% endfor %}
      {% endfor %}
    </div>
    {% endif %}

    {% if dept.slug == "robotic-surgery" %}
    <div style="margin-top:50px;padding:32px 36px;background:#f0f7ff;border-left:5px solid var(--primary);border-radius:var(--radius)">
      <h3 style="color:var(--primary);margin-bottom:12px">Led by Ahmedabad's Foremost Robotic Joint Replacement Expert</h3>
      <p style="color:var(--text-light);margin-bottom:16px">Our Robotic Joint Replacement programme is spearheaded by <strong><a href="https://www.drhardikshahortho.com/" rel="noopener" style="color:var(--primary)">Dr. Hardik Shah</a></strong>, one of Gujarat's most experienced orthopedic surgeons specialising in VELYS robotic knee and hip replacement. With thousands of successful procedures and rigorous training on the VELYS Robotic System, Dr. Shah combines precision technology with patient-centred care to deliver outstanding outcomes.</p>
      <a href="/velys-robotic-knee-replacement-ahmedabad/" class="btn btn-primary" style="font-size:0.92rem">Learn About VELYS Robotic Knee Replacement &rarr;</a>
      <a href="https://www.drhardikshahortho.com/" target="_blank" rel="noopener" class="btn btn-outline" style="font-size:0.92rem;margin-left:10px">View Dr. Hardik Shah's Full Profile &rarr;</a>
    </div>
    {% endif %}

    {% if dept.slug == "orthopedics" %}
    <div style="margin-top:50px;padding:28px 32px;background:linear-gradient(135deg,#e6f4ff 0%,#f0f9ff 100%);border-left:5px solid var(--primary);border-radius:var(--radius)">
      <h3 style="color:var(--primary);margin-bottom:12px">🌧️ Monsoon Joint Care Reminder</h3>
      <p style="color:var(--text-light);margin-bottom:18px">Monsoon brings more than rain — damp, cooler weather can make joint stiffness more noticeable for our parents and grandparents. A little extra care goes a long way: gentle movement, warm compresses, and not ignoring persistent discomfort. If a loved one's knee or joint pain has been bothering them this season, our team at DHS Hospital is here for a caring conversation.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        <a href="/appointment/" class="btn btn-primary">Book a Caring Consultation</a>
        <a href="/blog/monsoon-knee-joint-pain-ahmedabad/" class="btn btn-outline">Read Our Monsoon Joint Care Guide</a>
      </div>
    </div>
    {% endif %}

    {% if deptFaqs[dept.slug] %}
    <div class="faq-section" style="margin-top:50px">
      <h2 style="color:var(--primary);margin-bottom:20px">{{ dept.name }} — Frequently Asked Questions</h2>
      {% for item in deptFaqs[dept.slug] %}
      <details class="faq-item">
        <summary>{{ item.q }}</summary>
        <div class="faq-answer">{{ item.a }}</div>
      </details>
      {% endfor %}
    </div>
    {% endif %}

    <div style="margin-top:40px;text-align:center;padding:30px;background:var(--primary-light);border-radius:var(--radius)">
      <h3 style="color:var(--primary);margin-bottom:10px">Book a {{ dept.name }} Consultation in Ahmedabad</h3>
      <p style="margin-bottom:15px;color:var(--text-light)">Speak to our {{ dept.name }} specialists at DHS Multispecialty Hospital today.</p>
      <a href="/appointment/" class="btn btn-primary">Book Appointment</a>
      <a href="tel:{{ site.phones.emergency }}" class="btn btn-outline" style="margin-left:10px">Call {{ site.phones.emergency }}</a>
    </div>
  </div>
</section>
