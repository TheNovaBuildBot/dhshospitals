---
pagination:
  data: departments
  size: 1
  alias: dept
permalink: "departments/{{ dept.slug }}/"
layout: base.njk
eleventyComputed:
  title: "{{ dept.name }} — DHS Multispecialty Hospital Ahmedabad"
  description: "{{ dept.short_desc }} Expert {{ dept.name }} treatment at DHS Multispecialty Hospital, Ahmedabad."
  canonical: "https://dhshospitals.com/departments/{{ dept.slug }}/"
activePage: "departments"
---

<div class="page-banner">
  <div class="container">
    <h1>{{ dept.name }}</h1>
    <div class="breadcrumb"><a href="/">Home</a> / <a href="/departments/">Departments</a> / {{ dept.name }}</div>
  </div>
</div>

<section class="content-section">
  <div class="container">
    <div class="dept-detail-header">
      <div>
        <h2 style="color:var(--primary);margin-bottom:15px">{{ dept.name }} Department</h2>
        <p>{{ dept.full_desc }}</p>
        {% if dept.services and dept.services.length %}
        <h3 style="color:var(--primary);margin-top:25px;margin-bottom:15px">Services & Treatments</h3>
        <ul class="services-list">
          {% for service in dept.services %}
          <li>{{ service }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
      <div>
        <img src="{{ dept.image }}" alt="{{ dept.name }} department at DHS Hospital Ahmedabad" loading="lazy">
      </div>
    </div>

    {% if dept.doctors and dept.doctors.length %}
    <h3 style="color:var(--primary);margin:30px 0 20px">Our {{ dept.name }} Specialists</h3>
    <div class="doctors-grid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">
      {% for docSlug in dept.doctors %}
      {% for doc in doctors %}
      {% if doc.slug == docSlug %}
      <a href="/doctors/{{ doc.slug }}/" class="doctor-card" style="text-decoration:none;color:inherit">
        <img src="{{ doc.image }}" alt="{{ doc.name }}" loading="lazy">
        <div class="doctor-card-body">
          <h3>{{ doc.name }}</h3>
          <div class="qualification">{{ doc.qualification }}</div>
        </div>
      </a>
      {% endif %}
      {% endfor %}
      {% endfor %}
    </div>
    {% endif %}

    <div style="margin-top:40px;text-align:center;padding:30px;background:var(--primary-light);border-radius:var(--radius)">
      <h3 style="color:var(--primary);margin-bottom:10px">Need an Appointment?</h3>
      <p style="margin-bottom:15px;color:var(--text-light)">Book a consultation with our {{ dept.name }} specialists today.</p>
      <a href="/appointment/" class="btn btn-primary">Book Appointment</a>
      <a href="tel:{{ site.phones.emergency }}" class="btn btn-outline" style="margin-left:10px">Call {{ site.phones.emergency }}</a>
    </div>
  </div>
</section>
