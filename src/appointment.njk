---
layout: base.njk
title: "Book Appointment — DHS Multispecialty Hospital Ahmedabad"
description: "Book an appointment at DHS Multispecialty Hospital, Ahmedabad. Consult our expert doctors in orthopedics, cardiology, neurosurgery, and more."
canonical: "https://www.dhshospitals.com/appointment/"
breadcrumbs:
  - { name: "Home", url: "/" }
  - { name: "Appointment", url: "/appointment/" }
activePage: "home"
---

<div class="page-banner">
  <div class="container">
    <h1>Book Appointment</h1>
    <div class="breadcrumb"><a href="/">Home</a> / Appointment</div>
  </div>
</div>

<section class="content-section">
  <div class="container" style="max-width:700px">
    <h2 style="color:var(--primary);margin-bottom:20px;text-align:center">Make an Appointment</h2>
    <form action="https://formsubmit.co/{{ site.email }}" method="POST">
      <input type="hidden" name="_subject" value="Appointment Request - DHS Hospital">
      <input type="hidden" name="_captcha" value="false">
      <div class="form-group">
        <label for="appt-name">Full Name <span aria-label="required">*</span></label>
        <input type="text" name="name" id="appt-name" required aria-required="true" placeholder="Enter Full Name" autocomplete="name">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="appt-email">Email <span aria-label="required">*</span></label>
          <input type="email" name="email" id="appt-email" required aria-required="true" placeholder="Enter Email" autocomplete="email">
        </div>
        <div class="form-group">
          <label for="appt-phone">Phone <span aria-label="required">*</span></label>
          <input type="tel" name="phone" id="appt-phone" required aria-required="true" placeholder="Enter Phone No" maxlength="10" autocomplete="tel">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="appt-date">Preferred Date</label>
          <input type="date" name="date" id="appt-date">
        </div>
        <div class="form-group">
          <label for="appt-time">Preferred Time</label>
          <input type="time" name="time" id="appt-time">
        </div>
      </div>
      <div class="form-group">
        <label for="appt-dept">Department</label>
        <select name="department" id="appt-dept">
          <option value="">Select Department</option>
          {% for dept in departments %}
          <option value="{{ dept.name }}">{{ dept.name }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="form-group">
        <label for="appt-query">Your Query</label>
        <textarea name="query" id="appt-query" placeholder="Enter your query or symptoms"></textarea>
      </div>
      <p style="font-size:.8rem;color:var(--text-light);margin-bottom:15px">I agree to the <a href="/terms-conditions/">Terms & Conditions</a> and <a href="/privacy-policy/">Privacy Policy</a>.</p>
      <button type="submit" class="btn btn-primary" style="width:100%">Submit Appointment Request</button>
    </form>
    <div style="text-align:center;margin-top:25px;padding:20px;background:var(--primary-light);border-radius:var(--radius)">
      <p style="margin:0">Or call us directly: <strong><a href="tel:{{ site.phones.emergency }}">{{ site.phones.emergency }}</a></strong> (24x7)</p>
    </div>
  </div>
</section>
