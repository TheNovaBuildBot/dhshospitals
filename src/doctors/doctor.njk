---
pagination:
  data: doctors
  size: 1
  alias: doc
permalink: "doctors/{{ doc.slug }}/"
layout: base.njk
eleventyComputed:
  title: "{% if doc.seo_title %}{{ doc.seo_title }}{% else %}{{ doc.name }}, {{ (doc.specialty.split(' / '))[0] }} — DHS Ahmedabad{% endif %}"
  description: "{% if doc.seo_description %}{{ doc.seo_description }}{% else %}{{ doc.name }} — {{ doc.specialty }} specialist at DHS Multispecialty Hospital, Ahmedabad. Book consultation today.{% endif %}"
  canonical: "https://www.dhshospitals.com/doctors/{{ doc.slug }}/"
  og_type: "profile"
  og_image: "https://www.dhshospitals.com{{ doc.image }}"
  og_image_alt: "{{ doc.name }} — {{ doc.specialty }} at DHS Multispecialty Hospital"
  breadcrumbs:
    - { name: "Home", url: "/" }
    - { name: "Doctors", url: "/doctors/" }
    - { name: "{{ doc.name }}" , url: "/doctors/{{ doc.slug }}/" }
  pageSchema: |
    {
      "@type": "Physician",
      "@id": "https://www.dhshospitals.com/doctors/{{ doc.slug }}/#physician",
      "name": "{{ doc.name }}",
      "image": "https://www.dhshospitals.com{{ doc.image }}",
      "url": "https://www.dhshospitals.com/doctors/{{ doc.slug }}/",
      "description": "{{ doc.seo_description or (doc.name + ' — ' + doc.specialty + ' specialist at DHS Multispecialty Hospital, Ahmedabad.') }}",
      "medicalSpecialty": {% if doc.medicalSpecialtyList and doc.medicalSpecialtyList.length %}{{ doc.medicalSpecialtyList | dump }}{% else %}"{{ doc.specialty }}"{% endif %},
      "knowsLanguage": "{{ doc.languages or 'English, Hindi, Gujarati' }}",
      "worksFor": {
        "@type": "Hospital",
        "@id": "https://www.dhshospitals.com/#hospital",
        "name": "DHS Multispecialty Hospital",
        "url": "https://www.dhshospitals.com/",
        "telephone": "+91 9081610444",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "18 Sunrise Park Society, Vastrapur Lake - Drive in Link Road",
          "addressLocality": "Ahmedabad",
          "addressRegion": "Gujarat",
          "postalCode": "380052",
          "addressCountry": "IN"
        }
      },
      "memberOf": { "@id": "https://www.dhshospitals.com/#hospital" },
      "hospitalAffiliation": { "@id": "https://www.dhshospitals.com/#hospital" },
      "affiliatedWith": { "@type": "Hospital", "name": "DHS Multispecialty Hospital", "url": "https://dhshospitals.com" },
      "hasCredential": "{{ doc.qualification }}",
      "jobTitle": "{{ doc.role or doc.specialty + ' Specialist' }}",
      {% if doc.knowsAbout and doc.knowsAbout.length %}"knowsAbout": {{ doc.knowsAbout | dump }},{% endif %}
      {% if doc.sameAs and doc.sameAs.length %}"sameAs": {{ doc.sameAs | dump }},{% endif %}
      "telephone": "+91 9081610444",
      "email": "info@dhshospitals.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "18 Sunrise Park Society, Vastrapur Lake - Drive in Link Road",
        "addressLocality": "Ahmedabad",
        "addressRegion": "Gujarat",
        "postalCode": "380052",
        "addressCountry": "IN"
      },
      "areaServed": {% if doc.areaServedList and doc.areaServedList.length %}[{% for area in doc.areaServedList %}{ "@type": "City", "name": "{{ area }}" }{% if not loop.last %},{% endif %}{% endfor %}]{% else %}{ "@type": "City", "name": "Ahmedabad" }{% endif %},
      "availableService": [
        {% if doc.availableServiceList and doc.availableServiceList.length %}
        {% for svc in doc.availableServiceList %}
        { "@type": "MedicalProcedure", "name": "{{ svc }}" }{% if not loop.last %},{% endif %}
        {% endfor %}
        {% elif doc.specializations and doc.specializations.length %}
        {% for spec in doc.specializations %}
        { "@type": "MedicalProcedure", "name": "{{ spec.name }}" }{% if not loop.last %},{% endif %}
        {% endfor %}
        {% else %}
        { "@type": "MedicalProcedure", "name": "{{ doc.specialty }}" }
        {% endif %}
      ]
    }
activePage: "doctors"
---

<div class="page-banner">
  <div class="container">
    <h1>{% if doc.seo_h1 %}{{ doc.seo_h1 }}{% else %}{{ doc.name }}{% if doc.seo_h1_suffix %} — {{ doc.seo_h1_suffix }}{% endif %}{% endif %}</h1>
    <div class="breadcrumb"><a href="/">Home</a> / <a href="/doctors/">Doctors</a> / {{ doc.name }}</div>
  </div>
</div>

<section class="content-section">
  <div class="container">
    <div class="doctor-detail">
      <div>
        <img src="{{ doc.image }}" alt="{{ doc.name }} — {{ doc.specialty }} at DHS Hospital Ahmedabad" loading="lazy" width="300" height="380">
        <div style="margin-top:20px">
          <a href="/appointment/" class="btn btn-primary" style="width:100%;text-align:center">Book Appointment</a>
        </div>
        {% if doc.languages %}
        <div style="margin-top:15px;font-size:.85rem;color:var(--text-light)">
          <strong>Languages:</strong> {{ doc.languages }}
        </div>
        {% endif %}
        {% if doc.expertise %}
        <div style="margin-top:10px;font-size:.85rem;color:var(--text-light)">
          <strong>Expertise:</strong> {{ doc.expertise }}
        </div>
        {% endif %}
      </div>
      <div>
        <h2>{{ doc.name }}</h2>
        <div class="qualification">{{ doc.qualification }}</div>
        {% if doc.role %}<div class="role">{{ doc.role }}</div>{% endif %}
        <div style="color:var(--primary);font-weight:600;margin-bottom:20px">{{ doc.specialty }}</div>

        {% if doc.about %}
        <p>{{ doc.about | safe }}</p>
        {% endif %}
        {% if doc.about_extended %}
        <p>{{ doc.about_extended | safe }}</p>
        {% endif %}

        {% if doc.areasWeServe %}
        <h2 style="margin-top:25px;font-size:1.3rem">Areas We Serve</h2>
        <p>{{ doc.areasWeServe | safe }}</p>
        {% endif %}

        {% if doc.specializations and doc.specializations.length %}
        <div class="specialization-list">
          <h2 style="margin-top:25px;font-size:1.3rem">Areas of Expertise</h2>
          {% for spec in doc.specializations %}
          <div style="margin-top:15px">
            <h4 style="color:var(--primary);font-size:1rem;font-family:'Inter',sans-serif">{{ spec.name }}</h4>
            <p>{{ spec.desc }}</p>
          </div>
          {% endfor %}
        </div>
        {% endif %}

        {% if doc.closing %}
        <p style="margin-top:20px;font-style:italic;color:var(--text-light)">{{ doc.closing }}</p>
        {% endif %}

        {% if doc.languages %}
        <p style="margin-top:14px;font-size:.9rem;color:var(--text-light)">Consultation available in {{ doc.languages }}.</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% if doc.serviceAreas and doc.serviceAreas.length %}
<section class="content-section" style="background:var(--bg-light,#f8f9fb)">
  <div class="container">
    <h2>Service Areas &amp; Specialties</h2>
    {% for area in doc.serviceAreas %}
    <div style="margin-top:22px">
      <h3 style="color:var(--primary);font-size:1.05rem">{{ area.h3 }}</h3>
      <p>{{ area.content }}</p>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if doc.faqs and doc.faqs.length %}
<section class="content-section" id="faq">
  <div class="container">
    <h2>{% if doc.faqHeading %}{{ doc.faqHeading }}{% else %}Frequently Asked Questions — {{ doc.name }}, Internal Medicine Specialist{% endif %}</h2>
    <div class="faq-section">
      {% for item in doc.faqs %}
      <div class="faq-item" itemscope itemtype="https://schema.org/Question">
        <h4 itemprop="name">Q: {{ item.q }}</h4>
        <p itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <span itemprop="text">{{ item.a }}</span>
        </p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in doc.faqs %}
    {
      "@type": "Question",
      "name": {{ item.q | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ item.a | dump | safe }}
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
