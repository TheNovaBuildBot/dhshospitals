<!DOCTYPE html>
<html lang="en-IN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or site.title_suffix }}</title>
<meta name="description" content="{{ description or '' }}">
{% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
<meta name="geo.region" content="IN-GJ">
<meta name="geo.placename" content="Ahmedabad">
<meta name="geo.position" content="{{ site.geo.latitude }};{{ site.geo.longitude }}">
<meta name="ICBM" content="{{ site.geo.latitude }}, {{ site.geo.longitude }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="en_IN">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ og_title or title or site.title_suffix }}">
<meta property="og:description" content="{{ og_description or description or '' }}">
<meta property="og:image" content="{{ og_image or site.url + '/assets/images/logo.png' }}">
<meta property="og:url" content="{{ canonical or site.url }}">
{% if extra_head %}
<meta name="keywords" content="{{ keywords or '' }}">
{% endif %}
<link rel="icon" href="/assets/images/favicon/favicon.ico">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">

{% if extra_head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Hospital",
  "name": "{{ site.name }}",
  "description": "NABH-accredited multispecialty hospital in Ahmedabad offering orthopedics, cardiology, neurosurgery, oncology, gastroenterology, and 15+ specialties with 24/7 emergency care.",
  "url": "{{ site.url }}",
  "telephone": "{{ site.phones.emergency }}",
  "email": "{{ site.email }}",
  "image": "{{ site.url }}/assets/images/logo.png",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.address.line1 }}, {{ site.address.line2 }}",
    "addressLocality": "{{ site.address.city }}",
    "addressRegion": "{{ site.address.state }}",
    "postalCode": "{{ site.address.pincode }}",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "{{ site.geo.latitude }}",
    "longitude": "{{ site.geo.longitude }}"
  },
  "openingHours": "Mo-Su 00:00-23:59",
  "medicalSpecialty": ["Orthopedic Surgery", "Cardiology", "Neurosurgery", "Oncology", "Gastroenterology", "Urology", "Internal Medicine", "Critical Care"],
  "availableService": [
    { "@type": "MedicalProcedure", "name": "Knee Replacement Surgery", "procedureType": "Surgical" },
    { "@type": "MedicalProcedure", "name": "Hip Replacement Surgery", "procedureType": "Surgical" },
    { "@type": "MedicalProcedure", "name": "Arthroscopy", "procedureType": "Surgical" },
    { "@type": "MedicalProcedure", "name": "Cancer Surgery", "procedureType": "Surgical" },
    { "@type": "MedicalProcedure", "name": "Neurosurgery", "procedureType": "Surgical" },
    { "@type": "MedicalProcedure", "name": "Cardiac Diagnostics", "procedureType": "Diagnostic" }
  ],
  "areaServed": [
    { "@type": "City", "name": "Ahmedabad" },
    { "@type": "Place", "name": "Vastrapur, Ahmedabad" },
    { "@type": "Place", "name": "Gurukul, Ahmedabad" },
    { "@type": "Place", "name": "Satellite, Ahmedabad" },
    { "@type": "Place", "name": "Drive-In, Ahmedabad" },
    { "@type": "AdministrativeArea", "name": "Gujarat" }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "500",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": [
    {% for review in reviews %}
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Patient" },
      "reviewRating": { "@type": "Rating", "ratingValue": "{{ review.rating }}", "bestRating": "5" },
      "reviewBody": "{{ review.text | replace('"', '\\"') | truncate(200) }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  "hasMap": "{{ site.google_maps_embed }}",
  "sameAs": [
    "{{ site.google_reviews_url }}",
    "{{ site.social.facebook }}",
    "{{ site.social.instagram }}",
    "{{ site.social.linkedin }}",
    "{{ site.social.twitter }}",
    "https://drhardikshahortho.com/"
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for section in faq %}{% for item in section.items %}
    {
      "@type": "Question",
      "name": "{{ item.q }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ item.a | replace('"', '\\"') }}"
      }
    }{% if not loop.last or not loop.parent.last %},{% endif %}
    {% endfor %}{% endfor %}
  ]
}
</script>
{% endif %}

<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --primary: #0B5D8A;
  --primary-dark: #084468;
  --primary-light: #E8F4FA;
  --accent: #28A745;
  --accent-gold: #C4944A;
  --text: #1a1a2e;
  --text-light: #555;
  --bg: #fff;
  --bg-light: #f8f9fa;
  --border: #e0e0e0;
  --shadow: 0 2px 12px rgba(0,0,0,0.08);
  --radius: 8px;
}
body{font-family:'Inter',sans-serif;color:var(--text);line-height:1.7;background:var(--bg)}
h1,h2,h3,h4{font-family:'Playfair Display',serif;line-height:1.3}
a{color:var(--primary);text-decoration:none;transition:color .2s}
a:hover{color:var(--primary-dark)}
img{max-width:100%;height:auto;display:block}
.container{max-width:1200px;margin:0 auto;padding:0 20px}
.btn{display:inline-block;padding:12px 28px;border-radius:var(--radius);font-weight:600;font-size:.95rem;cursor:pointer;transition:all .3s;border:none;text-align:center}
.btn-primary{background:var(--primary);color:#fff}
.btn-primary:hover{background:var(--primary-dark);color:#fff}
.btn-accent{background:var(--accent);color:#fff}
.btn-accent:hover{background:#218838;color:#fff}
.btn-outline{border:2px solid var(--primary);color:var(--primary);background:transparent}
.btn-outline:hover{background:var(--primary);color:#fff}
.section{padding:60px 0}
.section-title{font-size:2rem;text-align:center;margin-bottom:.5rem;color:var(--primary)}
.section-subtitle{text-align:center;color:var(--text-light);max-width:700px;margin:0 auto 40px;font-size:1rem}
.top-bar{background:var(--primary-dark);color:#fff;padding:8px 0;font-size:.85rem}
.top-bar .container{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
.top-bar a{color:#fff;margin-left:15px}
.top-bar a:hover{color:var(--accent)}
.top-bar-left{display:flex;gap:20px;align-items:center;flex-wrap:wrap}
.top-bar-right{display:flex;gap:10px;align-items:center}
.top-bar .btn{padding:6px 16px;font-size:.8rem;border-radius:20px}
nav.main-nav{background:#fff;padding:0;position:sticky;top:0;z-index:100;box-shadow:var(--shadow)}
nav.main-nav .container{display:flex;justify-content:space-between;align-items:center}
.nav-logo img{height:60px;padding:8px 0}
.nav-links{display:flex;list-style:none;gap:0;align-items:center}
.nav-links>li{position:relative}
.nav-links>li>a{display:block;padding:20px 16px;font-weight:500;color:var(--text);font-size:.9rem;transition:color .2s}
.nav-links>li>a:hover,.nav-links>li>a.active{color:var(--primary)}
.nav-links .dropdown{position:absolute;top:100%;left:0;background:#fff;min-width:220px;box-shadow:var(--shadow);border-radius:0 0 var(--radius) var(--radius);display:none;z-index:200}
.nav-links li:hover .dropdown{display:block}
.dropdown a{display:block;padding:10px 20px;font-size:.85rem;color:var(--text);border-bottom:1px solid var(--border)}
.dropdown a:hover{background:var(--primary-light);color:var(--primary)}
.mega-menu{position:absolute;top:100%;left:-200px;background:#fff;min-width:700px;box-shadow:var(--shadow);border-radius:0 0 var(--radius) var(--radius);display:none;z-index:200;padding:20px}
.nav-links li:hover .mega-menu{display:block}
.mega-menu-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.mega-menu h4{font-family:'Inter',sans-serif;font-size:.8rem;color:var(--primary);margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px}
.mega-menu a{display:block;padding:6px 0;font-size:.85rem;color:var(--text)}
.mega-menu a:hover{color:var(--primary)}
.hamburger{display:none;cursor:pointer;font-size:1.5rem;padding:10px;color:var(--primary)}
.hero{position:relative;background:linear-gradient(135deg,var(--primary-dark),var(--primary));color:#fff;padding:80px 0;min-height:500px;display:flex;align-items:center;overflow:hidden}
.hero::after{content:'';position:absolute;top:0;right:0;width:50%;height:100%;background:url('/assets/images/hero/bg-2.png') center/cover no-repeat;opacity:.3}
.hero-content{position:relative;z-index:2;max-width:600px}
.hero h1{font-size:2.8rem;margin-bottom:20px;line-height:1.2}
.hero p{font-size:1.15rem;margin-bottom:30px;opacity:.9;line-height:1.8}
.hero-buttons{display:flex;gap:15px;flex-wrap:wrap}
.stats-bar{background:var(--primary);color:#fff;padding:30px 0}
.stats-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:20px;text-align:center}
.stat-item .stat-value{font-size:2.2rem;font-weight:700;font-family:'Playfair Display',serif}
.stat-item .stat-label{font-size:.85rem;opacity:.8;margin-top:4px}
.about-section{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
.about-image{border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}
.about-text h2{color:var(--primary);margin-bottom:15px}
.about-text .welcome{color:var(--accent-gold);font-weight:600;font-size:.9rem;text-transform:uppercase;letter-spacing:1px;margin-bottom:5px}
.about-text p{margin-bottom:15px;color:var(--text-light);font-size:.95rem}
.nabh-badge{display:inline-flex;align-items:center;gap:8px;background:var(--primary-light);padding:8px 16px;border-radius:20px;font-size:.85rem;font-weight:600;color:var(--primary);margin-top:10px}
.facilities-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:25px}
.facility-card{background:#fff;border-radius:var(--radius);padding:30px;text-align:center;box-shadow:var(--shadow);transition:transform .3s}
.facility-card:hover{transform:translateY(-5px)}
.facility-card img{width:50px;height:50px;margin:0 auto 15px;object-fit:contain}
.facility-card h3{font-size:1.1rem;margin-bottom:10px;color:var(--primary)}
.facility-card p{font-size:.85rem;color:var(--text-light);line-height:1.6}
.dept-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.dept-card{border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);transition:transform .3s;background:#fff}
.dept-card:hover{transform:translateY(-5px)}
.dept-card img{width:100%;height:180px;object-fit:cover}
.dept-card-body{padding:20px}
.dept-card h3{font-size:1rem;margin-bottom:8px;color:var(--primary)}
.dept-card p{font-size:.83rem;color:var(--text-light);line-height:1.5}
.dept-card .btn{margin-top:12px;padding:8px 20px;font-size:.8rem}
.doctors-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:25px}
.doctor-card{background:#fff;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);text-align:center;transition:transform .3s}
.doctor-card:hover{transform:translateY(-5px)}
.doctor-card img{width:100%;height:250px;object-fit:cover;object-position:top}
.doctor-card-body{padding:20px}
.doctor-card h3{font-size:1rem;margin-bottom:4px;color:var(--text)}
.doctor-card .qualification{font-size:.8rem;color:var(--primary);margin-bottom:4px}
.doctor-card .specialty{font-size:.8rem;color:var(--text-light)}
.reviews-section{background:var(--bg-light)}
.reviews-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:25px}
.review-card{background:#fff;border-radius:var(--radius);padding:30px;box-shadow:var(--shadow)}
.review-card .stars{color:#f5a623;font-size:1.1rem;margin-bottom:10px}
.review-card p{font-size:.9rem;color:var(--text-light);line-height:1.7;font-style:italic}
.review-card .source{margin-top:12px;font-size:.8rem;color:var(--primary);font-weight:600;font-style:normal}
.faq-section .faq-item{border:1px solid var(--border);border-radius:var(--radius);margin-bottom:10px;overflow:hidden}
.faq-item summary{padding:16px 20px;cursor:pointer;font-weight:600;font-size:.95rem;background:#fff;list-style:none;display:flex;justify-content:space-between;align-items:center}
.faq-item summary::after{content:'+';font-size:1.3rem;color:var(--primary);transition:transform .2s}
.faq-item[open] summary::after{content:'-'}
.faq-item .faq-answer{padding:0 20px 16px;font-size:.9rem;color:var(--text-light);line-height:1.7}
.faq-category{font-size:1.2rem;color:var(--primary);margin:25px 0 15px;font-family:'Playfair Display',serif}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}
.contact-info h3{color:var(--primary);margin-bottom:15px}
.contact-info p{margin-bottom:10px;font-size:.95rem;color:var(--text-light)}
.contact-info .info-item{display:flex;gap:10px;margin-bottom:15px;align-items:flex-start}
.contact-info .info-label{font-weight:600;color:var(--text);min-width:100px}
.form-group{margin-bottom:15px}
.form-group label{display:block;margin-bottom:5px;font-weight:500;font-size:.9rem}
.form-group input,.form-group textarea,.form-group select{width:100%;padding:10px 14px;border:1px solid var(--border);border-radius:var(--radius);font-size:.9rem;font-family:'Inter',sans-serif}
.form-group textarea{min-height:100px;resize:vertical}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.page-banner{background:linear-gradient(135deg,var(--primary-dark),var(--primary));color:#fff;padding:50px 0;text-align:center}
.page-banner h1{font-size:2.2rem;margin-bottom:8px}
.page-banner .breadcrumb{font-size:.9rem;opacity:.8}
.page-banner .breadcrumb a{color:#fff;opacity:.7}
.page-banner .breadcrumb a:hover{opacity:1}
.content-section{padding:60px 0}
.content-section p{margin-bottom:15px;color:var(--text-light);font-size:.95rem}
.plans-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:25px}
.plan-card{background:#fff;border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
.plan-card-header{background:var(--primary);color:#fff;padding:20px;text-align:center}
.plan-card-header h3{font-size:1.1rem}
.plan-card-body{padding:20px}
.plan-card-body ul{list-style:none;padding:0}
.plan-card-body li{padding:8px 0;border-bottom:1px solid var(--border);font-size:.85rem;color:var(--text-light);padding-left:20px;position:relative}
.plan-card-body li::before{content:'✓';position:absolute;left:0;color:var(--accent);font-weight:700}
.insurance-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.insurance-card{background:#fff;border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);display:flex;align-items:center;justify-content:center;min-height:80px}
.insurance-card img{max-height:50px;max-width:120px;object-fit:contain}
.unique-section{margin-bottom:40px}
.unique-section h3{color:var(--primary);margin-bottom:15px;font-size:1.3rem}
.unique-section ul{list-style:disc;padding-left:25px}
.unique-section li{margin-bottom:10px;color:var(--text-light);font-size:.95rem;line-height:1.6}
.doctor-detail{display:grid;grid-template-columns:300px 1fr;gap:40px;padding:40px 0}
.doctor-detail img{width:100%;border-radius:var(--radius);box-shadow:var(--shadow)}
.doctor-detail h2{color:var(--primary);margin-bottom:5px}
.doctor-detail .qualification{color:var(--accent-gold);font-weight:600;margin-bottom:5px}
.doctor-detail .role{color:var(--text-light);margin-bottom:20px}
.specialization-list{margin-top:20px}
.specialization-list h3{color:var(--primary);font-size:1.1rem;margin-bottom:8px}
.specialization-list p{color:var(--text-light);font-size:.9rem;margin-bottom:15px}
.dept-detail-header{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;margin-bottom:40px}
.dept-detail-header img{width:100%;border-radius:var(--radius);box-shadow:var(--shadow)}
.services-list{list-style:none;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px}
.services-list li{padding:10px 15px;background:var(--primary-light);border-radius:var(--radius);font-size:.9rem;color:var(--primary);font-weight:500}
.map-container{width:100%;height:400px;border-radius:var(--radius);overflow:hidden;margin-top:30px}
.map-container iframe{width:100%;height:100%;border:0}
footer{background:var(--text);color:#ccc;padding:50px 0 0}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:30px;margin-bottom:40px}
.footer-col h4{color:#fff;margin-bottom:15px;font-size:1rem}
.footer-col p,.footer-col a{font-size:.85rem;color:#aaa;line-height:1.8}
.footer-col a:hover{color:#fff}
.footer-col ul{list-style:none;padding:0}
.footer-col li{margin-bottom:6px}
.footer-logo img{height:50px;margin-bottom:15px;filter:brightness(0) invert(1)}
.footer-social{display:flex;gap:12px;margin-top:15px}
.footer-social a{width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;color:#fff;font-size:.85rem;transition:background .3s}
.footer-social a:hover{background:var(--primary)}
.footer-bottom{border-top:1px solid rgba(255,255,255,.1);padding:20px 0;text-align:center;font-size:.8rem;color:#888}
.footer-bottom a{color:#aaa;margin:0 10px}
.google-review-badge{display:flex;align-items:center;gap:15px;justify-content:center;margin:30px auto 0;padding:16px 28px;background:#fff;border:2px solid #e0e0e0;border-radius:12px;max-width:500px;text-decoration:none;color:var(--text);transition:all .3s;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.google-review-badge:hover{border-color:#4285F4;box-shadow:0 4px 16px rgba(66,133,244,.15);transform:translateY(-2px)}
.grb-logo{width:40px;height:40px;border-radius:50%;background:#4285F4;color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:700;flex-shrink:0}
.grb-info{text-align:left}
.grb-stars{color:#F4B400;font-size:1rem;letter-spacing:1px}
.grb-stars strong{color:var(--text);margin-left:4px}
.grb-text{font-size:.8rem;color:#666;margin-top:2px}
.grb-cta{font-size:.85rem;font-weight:600;color:#4285F4;white-space:nowrap;margin-left:auto}
.whatsapp-float{position:fixed;bottom:25px;right:25px;z-index:999;width:55px;height:55px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 15px rgba(37,211,102,.4);transition:transform .3s}
.whatsapp-float:hover{transform:scale(1.1)}
.whatsapp-float svg{width:28px;height:28px;fill:#fff}
@media(max-width:960px){
  .nav-links{display:none;position:absolute;top:100%;left:0;right:0;background:#fff;flex-direction:column;box-shadow:var(--shadow);padding:10px 0}
  .nav-links.open{display:flex}
  .nav-links>li>a{padding:12px 20px}
  .hamburger{display:block}
  .mega-menu,.dropdown{position:static;box-shadow:none;min-width:auto;padding:0 20px}
  .mega-menu-grid{grid-template-columns:1fr}
  .hero h1{font-size:2rem}
  .hero::after{display:none}
  .stats-grid{grid-template-columns:repeat(3,1fr)}
  .about-section{grid-template-columns:1fr}
  .facilities-grid{grid-template-columns:repeat(2,1fr)}
  .dept-grid{grid-template-columns:repeat(2,1fr)}
  .doctors-grid{grid-template-columns:repeat(2,1fr)}
  .reviews-grid{grid-template-columns:1fr}
  .contact-grid{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:repeat(2,1fr)}
  .doctor-detail{grid-template-columns:1fr}
  .dept-detail-header{grid-template-columns:1fr}
  .insurance-grid{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:600px){
  .stats-grid{grid-template-columns:repeat(2,1fr)}
  .facilities-grid{grid-template-columns:1fr}
  .dept-grid{grid-template-columns:1fr}
  .doctors-grid{grid-template-columns:1fr}
  .form-row{grid-template-columns:1fr}
  .plans-grid{grid-template-columns:1fr}
  .insurance-grid{grid-template-columns:repeat(2,1fr)}
  .hero{padding:50px 0;min-height:auto}
  .hero h1{font-size:1.7rem}
  .top-bar-left{display:none}
  .services-list{grid-template-columns:1fr}
}
</style>
</head>
<body>

{% include "header.njk" %}

{{ content | safe }}

