<!DOCTYPE html>
<html lang="en-IN">
<head>
<!-- Google tag (gtag.js) -->
{% if site.ga_id %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga_id }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ site.ga_id }}');
</script>
{% endif %}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or site.title_suffix }}</title>
<meta name="description" content="{{ description or '' }}">
{% if canonical %}<link rel="canonical" href="{{ canonical }}">
<link rel="alternate" hreflang="en-in" href="{{ canonical }}">
<link rel="alternate" hreflang="x-default" href="{{ canonical }}">{% endif %}
<meta name="theme-color" content="#0B5D8A">
<meta name="geo.region" content="IN-GJ">
<meta name="geo.placename" content="Ahmedabad">
<meta name="geo.position" content="{{ site.geo.latitude }};{{ site.geo.longitude }}">
<meta name="ICBM" content="{{ site.geo.latitude }}, {{ site.geo.longitude }}">
<meta property="og:type" content="{{ og_type or 'website' }}">
<meta property="og:locale" content="en_IN">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ og_title or title or site.title_suffix }}">
<meta property="og:description" content="{{ og_description or description or '' }}">
<meta property="og:image" content="{{ og_image or site.url + '/assets/images/logo.png' }}">
<meta property="og:image:width" content="{{ og_image_width or '1200' }}">
<meta property="og:image:height" content="{{ og_image_height or '630' }}">
<meta property="og:image:alt" content="{{ og_image_alt or site.name }}">
<meta property="og:url" content="{{ canonical or site.url }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title or title or site.title_suffix }}">
<meta name="twitter:description" content="{{ og_description or description or '' }}">
<meta name="twitter:image" content="{{ og_image or site.url + '/assets/images/logo.png' }}">
<meta name="twitter:image:alt" content="{{ og_image_alt or site.name }}">
{% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
<link rel="icon" type="image/x-icon" href="/assets/images/favicon/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicon/apple-touch-icon.png">
<link rel="manifest" href="/assets/images/favicon/site.webmanifest">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
{% if preload_hero %}<link rel="preload" as="image" href="/assets/images/hero/bg-2.png" fetchpriority="high">{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Hospital", "MedicalClinic", "EmergencyService"],
      "@id": "{{ site.url }}/#hospital",
      "name": "{{ site.name }}",
      "alternateName": "DHS Hospital",
      "description": "NABH-accredited multispecialty hospital in Ahmedabad offering orthopedics, cardiology, neurosurgery, oncology, gastroenterology, and 15+ specialties with 24/7 emergency care.",
      "url": "{{ site.url }}/",
      "logo": "{{ site.url }}/assets/images/logo.png",
      "image": "{{ site.url }}/assets/images/logo.png",
      "telephone": "{{ site.phones.emergency }}",
      "email": "{{ site.email }}",
      "priceRange": "₹₹",
      "currenciesAccepted": "INR",
      "paymentAccepted": "Cash, Credit Card, Debit Card, UPI, Insurance, Cashless",
      "isAcceptingNewPatients": true,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{ site.address.line1 }}, {{ site.address.line2 }}",
        "addressLocality": "{{ site.address.city }}",
        "addressRegion": "{{ site.address.state }}",
        "postalCode": "{{ site.address.pincode }}",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "{{ site.geo.latitude }}",
        "longitude": "{{ site.geo.longitude }}"
      },
      "hasMap": "https://www.google.com/maps?cid={{ site.google_place_cid }}",
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "name": "Emergency Services",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "00:00",
          "closes": "23:59"
        },
        {
          "@type": "OpeningHoursSpecification",
          "name": "OPD Visiting Hours",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "16:00",
          "closes": "18:00"
        }
      ],
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "telephone": "{{ site.phones.emergency }}",
          "contactType": "Emergency",
          "availableLanguage": ["English", "Hindi", "Gujarati"],
          "areaServed": "IN",
          "hoursAvailable": "Mo-Su 00:00-23:59"
        },
        {
          "@type": "ContactPoint",
          "telephone": "{{ site.phones.billing }}",
          "contactType": "Billing"
        },
        {
          "@type": "ContactPoint",
          "telephone": "{{ site.phones.landline1 }}",
          "contactType": "Reception"
        }
      ],
      "medicalSpecialty": ["Orthopedic", "Cardiovascular", "Surgical", "Oncologic", "Gastroenterologic", "Urologic", "Internal", "CriticalCare", "Pulmonary", "PlasticSurgery"],
      "availableService": [
        { "@type": "MedicalProcedure", "name": "VELYS Robotic Knee Replacement", "procedureType": "Surgical", "url": "{{ site.url }}/velys-robotic-knee-replacement-ahmedabad/" },
        { "@type": "MedicalProcedure", "name": "Robotic-Assisted Hip Replacement", "procedureType": "Surgical" },
        { "@type": "MedicalProcedure", "name": "Knee Replacement Surgery", "procedureType": "Surgical" },
        { "@type": "MedicalProcedure", "name": "Hip Replacement Surgery", "procedureType": "Surgical" },
        { "@type": "MedicalProcedure", "name": "Arthroscopy", "procedureType": "Surgical" },
        { "@type": "MedicalProcedure", "name": "Cancer Surgery", "procedureType": "Surgical" },
        { "@type": "MedicalProcedure", "name": "Neurosurgery", "procedureType": "Surgical" },
        { "@type": "MedicalProcedure", "name": "Cardiac Diagnostics", "procedureType": "Diagnostic" }
      ],
      "areaServed": [
        { "@type": "City", "name": "Ahmedabad" },
        { "@type": "Place", "name": "Vastrapur, Ahmedabad" },
        { "@type": "Place", "name": "Gurukul, Ahmedabad" },
        { "@type": "Place", "name": "Satellite, Ahmedabad" },
        { "@type": "Place", "name": "Drive-In, Ahmedabad" },
        { "@type": "AdministrativeArea", "name": "Gujarat" }
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "2000",
        "bestRating": "5",
        "worstRating": "1"
      },
      "sameAs": [
        "https://www.google.com/maps?cid={{ site.google_place_cid }}",
        "https://www.google.com/maps/place/DHS+Multispecialty+Hospital/@23.043011,72.5261337,17z",
        "{{ site.social.facebook }}",
        "{{ site.social.instagram }}",
        "{{ site.social.twitter }}",
        "https://drhardikshahortho.com/"
      ]
    },
    {
      "@type": "Organization",
      "@id": "{{ site.url }}/#organization",
      "name": "{{ site.name }}",
      "alternateName": ["DHS Hospital", "DHS Hospitals", "DHS Multispeciality Hospital"],
      "url": "{{ site.url }}/",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ site.url }}/assets/images/logo.png",
        "width": 400,
        "height": 100
      },
      "telephone": "{{ site.phones.emergency }}",
      "email": "{{ site.email }}",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{ site.address.line1 }}, {{ site.address.line2 }}",
        "addressLocality": "{{ site.address.city }}",
        "addressRegion": "{{ site.address.state }}",
        "postalCode": "{{ site.address.pincode }}",
        "addressCountry": "IN"
      },
      "foundingDate": "2018",
      "legalName": "{{ site.legal_entity }}",
      "sameAs": [
        "https://www.google.com/maps?cid={{ site.google_place_cid }}",
        "https://www.google.com/maps/place/DHS+Multispecialty+Hospital/@23.043011,72.5261337,17z",
        "https://www.justdial.com/Ahmedabad/DHS-Multispeciality-Hospital-Vastrapur-Lake-Drive-In-Road-Vastrapur/079P26844444NRN",
        "{{ site.social.facebook }}",
        "{{ site.social.instagram }}",
        "{{ site.social.twitter }}",
        "https://drhardikshahortho.com/"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}/",
      "name": "{{ site.name }}",
      "publisher": { "@id": "{{ site.url }}/#hospital" },
      "inLanguage": "en-IN"
    }{% if breadcrumbs and breadcrumbs.length %},
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {% for crumb in breadcrumbs %}{
          "@type": "ListItem",
          "position": {{ loop.index }},
          "name": "{{ crumb.name }}",
          "item": "{{ site.url }}{{ crumb.url }}"
        }{% if not loop.last %},{% endif %}{% endfor %}
      ]
    }{% endif %}{% set faqList = deptFaqs[dept.slug] if dept else null %}{% if faqList and faqList.length %},
    {
      "@type": "FAQPage",
      "mainEntity": [
        {%- for item in faqList -%}
        {%- if not loop.first %},{% endif -%}
        {
          "@type": "Question",
          "name": "{{ item.q }}",
          "acceptedAnswer": { "@type": "Answer", "text": "{{ item.a | replace('"', '\\"') }}" }
        }
        {%- endfor %}
      ]
    }{% endif %}{% if extra_head %},
    {
      "@type": "FAQPage",
      "@id": "{{ site.url }}/#faq",
      "mainEntity": [
        {%- for section in faq -%}
        {%- if not loop.first %},{% endif -%}
        {%- for item in section.items -%}
        {%- if not loop.first %},{% endif -%}
        {
          "@type": "Question",
          "name": "{{ item.q }}",
          "acceptedAnswer": { "@type": "Answer", "text": "{{ item.a | replace('"', '\\"') }}" }
        }
        {%- endfor -%}
        {%- endfor %}
      ]
    }{% endif %}{% if pageSchema %},
    {{ pageSchema | safe }}{% endif %},
    {
      "@type": "WebPage",
      "@id": "{{ canonical or site.url }}#webpage",
      "url": "{{ canonical or site.url }}",
      "name": "{{ title or site.title_suffix }}",
      "description": "{{ description or '' }}",
      "isPartOf": { "@id": "{{ site.url }}/#website" },
      "about": { "@id": "{{ site.url }}/#hospital" },
      "inLanguage": "en-IN",
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["h1", ".hero p", ".section-subtitle", ".faq-answer", ".content-section p"]
      }
    }
  ]
}
</script>

{% if page.url and page.url != "/" %}
{% set urlParts = page.url.split("/") %}
{% set section = urlParts[1] %}
{% set isSubPage = urlParts.length > 3 %}
{% set leafName = title.split(" — ")[0] if title else "" %}
{% if dept and dept.name %}{% set leafName = dept.name %}{% endif %}
{% if doc and doc.name %}{% set leafName = doc.name %}{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" }
    {% if section == "departments" and isSubPage %}
    ,{ "@type": "ListItem", "position": 2, "name": "Clinical Departments", "item": "{{ site.url }}/departments/" }
    ,{ "@type": "ListItem", "position": 3, "name": "{{ leafName }}", "item": "{{ canonical }}" }
    {% elif section == "doctors" and isSubPage %}
    ,{ "@type": "ListItem", "position": 2, "name": "Find a Doctor", "item": "{{ site.url }}/doctors/" }
    ,{ "@type": "ListItem", "position": 3, "name": "{{ leafName }}", "item": "{{ canonical }}" }
    {% elif section == "blog" and urlParts[2] == "posts" %}
    ,{ "@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ site.url }}/blog/" }
    ,{ "@type": "ListItem", "position": 3, "name": "{{ leafName }}", "item": "{{ canonical }}" }
    {% else %}
    ,{ "@type": "ListItem", "position": 2, "name": "{{ leafName }}", "item": "{{ canonical or site.url + page.url }}" }
    {% endif %}
  ]
}
</script>
{% endif %}

<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --primary: #0B5D8A;
  --primary-dark: #084468;
  --primary-light: #E8F4FA;
  --accent: #28A745;
  --accent-gold: #9E7530;
  --text: #1a1a2e;
  --text-light: #4a4a4a;
  --bg: #fff;
  --bg-light: #f8f9fa;
  --border: #e0e0e0;
  --shadow: 0 2px 12px rgba(0,0,0,0.08);
  --radius: 8px;
}
body{font-family:'Inter',sans-serif;color:var(--text);line-height:1.7;background:var(--bg);font-size:1rem}
.skip-link{position:absolute;top:-100%;left:50%;transform:translateX(-50%);background:var(--primary);color:#fff;padding:12px 24px;z-index:9999;border-radius:0 0 var(--radius) var(--radius);font-weight:600;transition:top .2s}
.skip-link:focus{top:0;color:#fff}
:focus-visible{outline:3px solid var(--primary);outline-offset:2px}
a:focus:not(:focus-visible),button:focus:not(:focus-visible){outline:none}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
h1,h2,h3,h4{font-family:'Inter',sans-serif;line-height:1.22;font-weight:600;letter-spacing:-.01em}
a{color:var(--primary);text-decoration:none;transition:color .2s}
a:hover{color:var(--primary-dark)}
img{max-width:100%;height:auto;display:block}
.container{max-width:1200px;margin:0 auto;padding:0 20px}
.btn{display:inline-block;padding:12px 28px;border-radius:var(--radius);font-weight:600;font-size:.95rem;cursor:pointer;transition:all .3s;border:none;text-align:center}
.btn-primary{background:var(--primary);color:#fff}
.btn-primary:hover{background:var(--primary-dark);color:#fff}
.btn-accent{background:var(--accent);color:#fff}
.btn-accent:hover{background:#218838;color:#fff}
.btn-outline{border:2px solid var(--primary);color:var(--primary);background:transparent}
.btn-outline:hover{background:var(--primary);color:#fff}
.section{padding:60px 0}
.section-title{font-size:2rem;text-align:center;margin-bottom:.5rem;color:var(--primary)}
.section-subtitle{text-align:center;color:var(--text-light);max-width:700px;margin:0 auto 40px;font-size:1rem}
.top-bar{background:var(--primary-dark);color:#fff;padding:10px 0;font-size:.85rem}
.top-bar .container{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
.top-bar a{color:#fff}
.top-bar a:hover{color:var(--accent)}
.top-bar-left{display:flex;gap:24px;align-items:center;flex-wrap:wrap}
.top-bar-right{display:flex;gap:14px;align-items:center}
.top-bar-emergency{font-size:.88rem}
.top-bar-emergency strong{font-weight:700;margin-right:4px}
.top-bar-emergency a{font-weight:600;font-size:.95rem}
.top-bar-cashless{display:inline-flex;align-items:center;gap:6px;background:rgba(40,167,69,.18);border:1px solid rgba(40,167,69,.55);padding:4px 12px;border-radius:14px;color:#fff;font-size:.78rem;font-weight:600;letter-spacing:.01em;transition:background .2s,border-color .2s}
.top-bar-cashless:hover{background:rgba(40,167,69,.32);border-color:rgba(40,167,69,.85);color:#fff}
.top-bar-cashless .cashless-check{display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;background:var(--accent);border-radius:50%;color:#fff;font-size:.7rem;font-weight:800;line-height:1}
.email-link a{margin-left:4px}
nav.main-nav{background:#fff;padding:0;position:sticky;top:0;z-index:100;box-shadow:0 2px 16px rgba(0,0,0,.1)}
nav.main-nav .container{display:flex;align-items:center}
.nav-logo{margin-right:auto}
.nav-logo img{height:72px;padding:10px 0}
.nav-links{display:flex;flex-wrap:wrap;list-style:none;gap:0;align-items:center;justify-content:center;max-width:720px}
.nav-links>li{position:relative}
.nav-break{flex-basis:100%;height:0;width:0;padding:0;margin:0}
.nav-links>li>a{display:block;padding:15px 10px;font-weight:600;color:var(--text);font-size:.98rem;transition:color .2s;letter-spacing:normal;white-space:nowrap}
.nav-links>li>a:hover,.nav-links>li>a.active{color:var(--primary)}
.nav-links>li>a.active{border-bottom:3px solid var(--primary);margin-bottom:-3px}
.nav-links>li>a.nav-robotic{color:var(--accent);font-weight:700}
.nav-links>li>a.nav-robotic:hover{color:#218838}
.nav-links>li>a.nav-robotic.active{border-bottom-color:var(--accent)}
.nav-links .dropdown{position:absolute;top:100%;left:0;background:#fff;min-width:240px;box-shadow:0 8px 24px rgba(0,0,0,.12);border-radius:0 0 var(--radius) var(--radius);display:none;z-index:200}
.nav-links li:hover .dropdown{display:block}
.dropdown{list-style:none}
.dropdown li{list-style:none}
.dropdown a{display:block;padding:12px 24px;font-size:.9rem;color:var(--text);border-bottom:1px solid var(--border)}
.dropdown a:hover{background:var(--primary-light);color:var(--primary)}
.mega-menu{position:absolute;top:100%;left:-200px;background:#fff;min-width:980px;box-shadow:0 8px 24px rgba(0,0,0,.12);border-radius:0 0 var(--radius) var(--radius);display:none;z-index:200;padding:28px 32px}
.nav-links li:hover .mega-menu{display:block}
.mega-menu-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.mega-menu-grid-4{grid-template-columns:repeat(4,1fr);gap:24px}
.mega-menu h4{font-family:'Inter',sans-serif;font-size:.78rem;color:var(--primary);margin-bottom:12px;text-transform:uppercase;letter-spacing:.08em;font-weight:700;border-bottom:1px solid var(--border);padding-bottom:8px}
.mega-menu a{display:block;padding:7px 0;font-size:.88rem;color:var(--text);line-height:1.4}
.mega-menu a:hover{color:var(--primary)}
.mega-menu a.nav-highlight{color:var(--primary)}
.mega-menu a.nav-highlight:hover{color:var(--primary-dark)}
.nav-badge{display:inline-block;background:var(--accent);color:#fff;font-size:.6rem;font-weight:800;padding:2px 6px;border-radius:8px;letter-spacing:.5px;margin-left:6px;vertical-align:middle;line-height:1.2;text-transform:uppercase}
.nav-cta{display:flex;align-items:center;margin-left:10px}
.btn-nav-book{padding:9px 16px;font-size:.83rem;border-radius:24px;white-space:nowrap}
.hamburger{display:none;cursor:pointer;font-size:1.8rem;padding:12px;color:var(--primary);background:none;border:none;font-family:inherit}
.nav-links>li>a:focus-visible+.dropdown,.nav-links>li>a:focus-visible+.mega-menu,.dropdown:focus-within,.mega-menu:focus-within{display:block}
.hero{position:relative;background:url('/assets/images/hero/bg-2.png') center right/cover no-repeat;color:#fff;padding:80px 0;min-height:500px;display:flex;align-items:center;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:linear-gradient(to right,var(--primary-dark) 30%,rgba(11,93,138,.85) 60%,rgba(11,93,138,.7) 100%)}
.hero-content{position:relative;z-index:2;max-width:600px}
.hero h1{font-size:2.8rem;margin-bottom:20px;line-height:1.2}
.hero p{font-size:1.15rem;margin-bottom:30px;opacity:.9;line-height:1.8}
.hero-buttons{display:flex;gap:15px;flex-wrap:wrap}
.stats-bar{background:var(--primary);color:#fff;padding:30px 0}
.stats-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:20px;text-align:center}
.stat-item .stat-value{font-size:2.2rem;font-weight:700;font-family:'Inter',sans-serif}
.stat-item .stat-label{font-size:.85rem;opacity:.8;margin-top:4px}
.about-section{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
.about-image{border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}
.about-text h2{color:var(--primary);margin-bottom:15px}
.about-text .welcome{color:var(--accent-gold);font-weight:600;font-size:.9rem;text-transform:uppercase;letter-spacing:1px;margin-bottom:5px}
.about-text p{margin-bottom:15px;color:var(--text-light);font-size:.95rem}
.nabh-badge{display:inline-flex;align-items:center;gap:8px;background:var(--primary-light);padding:8px 16px;border-radius:20px;font-size:.85rem;font-weight:600;color:var(--primary);margin-top:10px}
.facilities-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:25px}
.facility-card{background:#fff;border-radius:var(--radius);padding:30px;text-align:center;box-shadow:var(--shadow);transition:transform .3s}
.facility-card:hover{transform:translateY(-5px)}
.facility-card img{width:50px;height:50px;margin:0 auto 15px;object-fit:contain}
.facility-card h3{font-size:1.1rem;margin-bottom:10px;color:var(--primary)}
.facility-card p{font-size:.85rem;color:var(--text-light);line-height:1.6}
.dept-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.dept-card{border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);transition:transform .3s;background:#fff}
.dept-card:hover{transform:translateY(-5px)}
.dept-card img{width:100%;height:180px;object-fit:cover}
.dept-card-body{padding:20px}
.dept-card h3{font-size:1rem;margin-bottom:8px;color:var(--primary)}
.dept-card p{font-size:.83rem;color:var(--text-light);line-height:1.5}
.dept-card .btn{margin-top:12px;padding:8px 20px;font-size:.8rem}
.doctors-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:25px}
.doctor-card{background:#fff;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);text-align:center;transition:transform .3s}
.doctor-card:hover{transform:translateY(-5px)}
.doctor-card img{width:100%;height:250px;object-fit:cover;object-position:top}
.doctor-card-body{padding:20px}
.doctor-card h3{font-size:1rem;margin-bottom:4px;color:var(--text)}
.doctor-card .qualification{font-size:.8rem;color:var(--primary);margin-bottom:4px}
.doctor-card .specialty{font-size:.8rem;color:var(--text-light)}
.reviews-section{background:var(--bg-light)}
.reviews-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:25px}
.review-card{background:#fff;border-radius:var(--radius);padding:30px;box-shadow:var(--shadow)}
.review-card .stars{color:#f5a623;font-size:1.1rem;margin-bottom:10px}
.review-card p{font-size:.9rem;color:var(--text-light);line-height:1.7;font-style:italic}
.review-card .source{margin-top:12px;font-size:.8rem;color:var(--primary);font-weight:600;font-style:normal}
.faq-section .faq-item{border:1px solid var(--border);border-radius:var(--radius);margin-bottom:10px;overflow:hidden}
.faq-item summary{padding:16px 20px;cursor:pointer;font-weight:600;font-size:.95rem;background:#fff;list-style:none;display:flex;justify-content:space-between;align-items:center}
.faq-item summary::after{content:'+';font-size:1.3rem;color:var(--primary);transition:transform .2s}
.faq-item[open] summary::after{content:'-'}
.faq-item .faq-answer{padding:0 20px 16px;font-size:.9rem;color:var(--text-light);line-height:1.7}
.faq-category{font-size:1.2rem;color:var(--primary);margin:25px 0 15px;font-family:'Inter',sans-serif}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}
.contact-info h3{color:var(--primary);margin-bottom:15px}
.contact-info p{margin-bottom:10px;font-size:.95rem;color:var(--text-light)}
.contact-info .info-item{display:flex;gap:10px;margin-bottom:15px;align-items:flex-start}
.contact-info .info-label{font-weight:600;color:var(--text);min-width:100px}
.form-group{margin-bottom:15px}
.form-group label{display:block;margin-bottom:5px;font-weight:500;font-size:.9rem}
.form-group input,.form-group textarea,.form-group select{width:100%;padding:10px 14px;border:1px solid var(--border);border-radius:var(--radius);font-size:.9rem;font-family:'Inter',sans-serif}
.form-group textarea{min-height:100px;resize:vertical}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.page-banner{background:linear-gradient(135deg,var(--primary-dark),var(--primary));color:#fff;padding:50px 0;text-align:center}
.page-banner h1{font-size:2.2rem;margin-bottom:8px}
.page-banner .breadcrumb{font-size:.9rem;opacity:.8}
.page-banner .breadcrumb a{color:#fff;opacity:.7}
.page-banner .breadcrumb a:hover{opacity:1}
.content-section{padding:60px 0}
.content-section p{margin-bottom:15px;color:var(--text-light);font-size:.95rem}
.plans-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:25px}
.plan-card{background:#fff;border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
.plan-card-header{background:var(--primary);color:#fff;padding:20px;text-align:center}
.plan-card-header h3{font-size:1.1rem}
.plan-card-body{padding:20px}
.plan-card-body ul{list-style:none;padding:0}
.plan-card-body li{padding:8px 0;border-bottom:1px solid var(--border);font-size:.85rem;color:var(--text-light);padding-left:20px;position:relative}
.plan-card-body li::before{content:'✓';position:absolute;left:0;color:var(--accent);font-weight:700}
.insurance-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.insurance-card{background:#fff;border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);display:flex;align-items:center;justify-content:center;min-height:80px}
.insurance-card img{max-height:50px;max-width:120px;object-fit:contain}
.unique-section{margin-bottom:40px}
.unique-section h3{color:var(--primary);margin-bottom:15px;font-size:1.3rem}
.unique-section ul{list-style:disc;padding-left:25px}
.unique-section li{margin-bottom:10px;color:var(--text-light);font-size:.95rem;line-height:1.6}
.doctor-detail{display:grid;grid-template-columns:300px 1fr;gap:40px;padding:40px 0}
.doctor-detail img{width:100%;border-radius:var(--radius);box-shadow:var(--shadow)}
.doctor-detail h2{color:var(--primary);margin-bottom:5px}
.doctor-detail .qualification{color:var(--accent-gold);font-weight:600;margin-bottom:5px}
.doctor-detail .role{color:var(--text-light);margin-bottom:20px}
.specialization-list{margin-top:20px}
.specialization-list h3{color:var(--primary);font-size:1.1rem;margin-bottom:8px}
.specialization-list p{color:var(--text-light);font-size:.9rem;margin-bottom:15px}
.dept-detail-header{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;margin-bottom:40px}
.dept-detail-header img{width:100%;border-radius:var(--radius);box-shadow:var(--shadow)}
.dept-intro{margin-bottom:24px;overflow:auto}
.dept-intro-heading{color:var(--primary);margin-bottom:14px}
.dept-intro-image{float:right;width:320px;max-width:42%;margin:4px 0 16px 28px;border-radius:var(--radius);box-shadow:var(--shadow);height:auto}
.dept-intro p{margin-bottom:14px;line-height:1.7}
.dept-intro p:last-child{margin-bottom:0}
.dept-services-heading{color:var(--primary);margin:24px 0 12px}
@media(max-width:768px){.dept-intro-image{float:none;width:100%;max-width:100%;margin:0 0 16px;display:block}}
.services-list{list-style:none;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px}
.services-list li{padding:10px 15px;background:var(--primary-light);border-radius:var(--radius);font-size:.9rem;color:var(--primary);font-weight:500}
.map-container{width:100%;height:400px;border-radius:var(--radius);overflow:hidden;margin-top:30px}
.map-container iframe{width:100%;height:100%;border:0}
footer{background:var(--text);color:#ccc;padding:50px 0 0}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:30px;margin-bottom:40px}
.footer-col h4{color:#fff;margin-bottom:15px;font-size:1rem}
.footer-col p,.footer-col a{font-size:.85rem;color:#aaa;line-height:1.8}
.footer-col a:hover{color:#fff}
.footer-col ul{list-style:none;padding:0}
.footer-col li{margin-bottom:6px}
.footer-logo img{height:50px;margin-bottom:15px;filter:brightness(0) invert(1)}
.footer-social{display:flex;gap:12px;margin-top:15px}
.footer-social a{width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;color:#fff;font-size:.85rem;transition:background .3s}
.footer-social a:hover{background:var(--primary)}
.footer-bottom{border-top:1px solid rgba(255,255,255,.1);padding:20px 0;text-align:center;font-size:.8rem;color:#888}
.footer-bottom a{color:#aaa;margin:0 10px}
.google-trust-strip{display:flex;align-items:center;justify-content:center;gap:10px;padding:12px 20px;background:#fff;text-decoration:none;color:var(--text);font-size:.9rem;border-bottom:1px solid #eee;transition:background .2s;flex-wrap:wrap}
.google-trust-strip:hover{background:#f8f9ff}
.gts-stars{color:#F4B400;font-size:1rem;letter-spacing:1px}
.gts-rating{font-size:.9rem}
.gts-count{color:var(--text-light)}
.gts-sep{color:#ccc}
.gts-cta{color:#4285F4;font-weight:600}
@media(max-width:600px){.gts-sep:last-of-type,.gts-cta{display:none}}
.google-review-badge{display:flex;align-items:center;gap:15px;justify-content:center;margin:30px auto 0;padding:16px 28px;background:#fff;border:2px solid #e0e0e0;border-radius:12px;max-width:500px;text-decoration:none;color:var(--text);transition:all .3s;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.google-review-badge:hover{border-color:#4285F4;box-shadow:0 4px 16px rgba(66,133,244,.15);transform:translateY(-2px)}
.grb-logo{width:40px;height:40px;border-radius:50%;background:#4285F4;color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:700;flex-shrink:0}
.grb-info{text-align:left}
.grb-stars{color:#F4B400;font-size:1rem;letter-spacing:1px}
.grb-stars strong{color:var(--text);margin-left:4px}
.grb-text{font-size:.8rem;color:#666;margin-top:2px}
.grb-cta{font-size:.85rem;font-weight:600;color:#4285F4;white-space:nowrap;margin-left:auto}
.whatsapp-float{position:fixed;bottom:25px;right:25px;z-index:999;width:55px;height:55px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 15px rgba(37,211,102,.4);transition:transform .3s}
.whatsapp-float:hover{transform:scale(1.1)}
.whatsapp-float svg{width:28px;height:28px;fill:#fff}
@media(max-width:960px){
  .nav-links{display:none;position:absolute;top:100%;left:0;right:0;background:#fff;flex-direction:column;flex-wrap:nowrap;box-shadow:var(--shadow);padding:10px 0;max-width:none;justify-content:flex-start}
  .nav-links.open{display:flex}
  .nav-links>li>a{padding:12px 20px;font-size:.95rem;letter-spacing:.01em;white-space:normal}
  .nav-break{display:none}
  .hamburger{display:block}
  .nav-cta{display:flex;margin-left:0;margin-right:8px}
  .btn-nav-book{padding:8px 16px;font-size:.82rem}
  .mega-menu,.dropdown{position:static;box-shadow:none;min-width:auto;padding:0 20px}
  .mega-menu-grid,.mega-menu-grid-4{grid-template-columns:1fr;gap:0}
  .hero h1{font-size:2rem}
  .hero::before{background:rgba(8,68,104,.85)}
  .stats-grid{grid-template-columns:repeat(3,1fr)}
  .about-section{grid-template-columns:1fr}
  .facilities-grid{grid-template-columns:repeat(2,1fr)}
  .dept-grid{grid-template-columns:repeat(2,1fr)}
  .doctors-grid{grid-template-columns:repeat(2,1fr)}
  .reviews-grid{grid-template-columns:1fr}
  .contact-grid{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:repeat(2,1fr)}
  .doctor-detail{grid-template-columns:1fr}
  .dept-detail-header{grid-template-columns:1fr}
  .insurance-grid{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:600px){
  .stats-grid{grid-template-columns:repeat(2,1fr)}
  .facilities-grid{grid-template-columns:1fr}
  .dept-grid{grid-template-columns:1fr}
  .doctors-grid{grid-template-columns:1fr}
  .form-row{grid-template-columns:1fr}
  .plans-grid{grid-template-columns:1fr}
  .insurance-grid{grid-template-columns:repeat(2,1fr)}
  .hero{padding:50px 0;min-height:auto}
  .hero h1{font-size:1.7rem}
  .email-link{display:none}
  .top-bar-cashless{font-size:.7rem;padding:3px 9px}
  .top-bar-cashless .cashless-check{width:14px;height:14px;font-size:.6rem}
  .top-bar-emergency{font-size:.82rem}
  .top-bar-emergency a{font-size:.88rem}
  .services-list{grid-template-columns:1fr}
}

/* Localities / sub-locality AEO section — was added unstyled by an earlier
   agent run, so it rendered as a plain block with no separation. Style it to
   match the site + set it apart from the content above it. */
#localities-served{margin-top:48px;padding-top:36px;border-top:1px solid var(--border)}
#localities-served h2{font-size:1.8rem;color:var(--primary);margin-bottom:1.25rem}
#localities-served h3{font-size:1.15rem;color:var(--primary-dark);margin:1.5rem 0 .5rem}
#localities-served p{color:var(--text-light);line-height:1.7;margin-bottom:1rem}

/* Media Coverage & Press page */
.media-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:25px;margin-top:10px}
.media-card{background:#fff;border-radius:var(--radius);padding:30px;box-shadow:var(--shadow);display:flex;flex-direction:column}
.media-card .media-badge{display:inline-flex;align-items:center;gap:8px;background:var(--primary-light);color:var(--primary-dark);font-weight:700;font-size:.85rem;padding:6px 14px;border-radius:999px;width:fit-content;margin-bottom:16px}
.media-card .media-date{color:var(--text-light);font-size:.8rem;margin-bottom:10px;letter-spacing:.02em}
.media-card h3{font-size:1.15rem;color:var(--text);line-height:1.4;margin-bottom:18px}
.media-card .btn{margin-top:auto;align-self:flex-start}
.media-card-placeholder{border:2px dashed var(--border);border-radius:var(--radius);padding:30px;display:flex;align-items:center;justify-content:center;text-align:center;color:var(--text-light);font-size:.9rem;min-height:220px}
@media (max-width:768px){
  .media-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>

