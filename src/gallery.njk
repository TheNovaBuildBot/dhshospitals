---
layout: base.njk
title: "Photo Gallery — DHS Multispecialty Hospital Ahmedabad"
description: "Photo gallery of DHS Multispecialty Hospital, Ahmedabad. See our state-of-the-art facility, patient rooms, operation theatres, ICU, and hospital infrastructure."
canonical: "https://dhshospitals.com/gallery/"
activePage: "more"
---

<div class="page-banner">
  <div class="container">
    <h1>Photo Gallery</h1>
    <div class="breadcrumb"><a href="/">Home</a> / Photo Gallery</div>
  </div>
</div>

<section class="content-section">
  <div class="container">
    <p class="section-subtitle" style="margin-bottom:40px">A glimpse inside DHS Multispecialty Hospital — our facility, infrastructure, and patient care</p>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px">
      {% for i in range(1, 5) %}
      <a href="/assets/images/gallery/pg-{{ i }}.jpg" target="_blank" rel="noopener" style="display:block;border-radius:var(--radius);overflow:hidden">
        <img src="/assets/images/gallery/pg-{{ i }}.jpg" alt="DHS Multispecialty Hospital facility photo {{ i }}" loading="lazy" style="width:100%;height:250px;object-fit:cover;transition:transform .3s">
      </a>
      {% endfor %}
      {% for i in range(1, 18) %}
      <a href="/assets/images/gallery/{{ i }}.jpg" target="_blank" rel="noopener" style="display:block;border-radius:var(--radius);overflow:hidden">
        <img src="/assets/images/gallery/{{ i }}.jpg" alt="DHS Multispecialty Hospital photo {{ i }}" loading="lazy" style="width:100%;height:250px;object-fit:cover;transition:transform .3s">
      </a>
      {% endfor %}
    </div>
    <div style="text-align:center;margin-top:40px">
      <a href="{{ site.virtual_tour_url }}" target="_blank" rel="noopener" class="btn btn-primary">Take a Virtual Tour</a>
    </div>
  </div>
</section>
