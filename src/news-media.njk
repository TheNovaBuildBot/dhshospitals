---
layout: base.njk
title: "News & Media — DHS Multispecialty Hospital Ahmedabad"
description: "DHS Multispecialty Hospital in the news — events, medical camps, and community outreach in Ahmedabad."
canonical: "https://www.dhshospitals.com/news-media/"
breadcrumbs:
  - { name: "Home", url: "/" }
  - { name: "News & Media", url: "/news-media/" }
activePage: "news"
---

<div class="page-banner">
  <div class="container">
    <h1>News & Media</h1>
    <div class="breadcrumb"><a href="/">Home</a> / News & Media</div>
  </div>
</div>

<section class="content-section">
  <div class="container">
    <p class="section-subtitle" style="margin-bottom:40px">DHS Multispecialty Hospital in the news — events, medical camps, and community outreach</p>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px">
      {% for i in range(1, 18) %}
      <a href="#" class="lightbox-trigger" data-index="{{ i - 1 }}" style="display:block;border-radius:var(--radius);overflow:hidden;cursor:pointer">
        <img src="/assets/images/gallery/{{ i }}.jpg" alt="DHS Hospital news photo {{ i }}" loading="lazy" style="width:100%;height:220px;object-fit:cover;transition:transform .3s" width="600" height="400">
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<div class="lightbox-overlay" id="lightbox" style="display:none">
  <div class="lightbox-backdrop"></div>
  <button class="lightbox-close" aria-label="Close gallery">&times;</button>
  <button class="lightbox-prev" aria-label="Previous image">&#8249;</button>
  <button class="lightbox-next" aria-label="Next image">&#8250;</button>
  <div class="lightbox-content">
    <img id="lightbox-img" src="" alt="DHS Hospital news" width="600" height="400">
    <div class="lightbox-counter" id="lightbox-counter"></div>
  </div>
</div>

<style>
.lightbox-overlay{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center}
.lightbox-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.9)}
.lightbox-content{position:relative;z-index:2;max-width:90vw;max-height:85vh;text-align:center}
.lightbox-content img{max-width:100%;max-height:80vh;border-radius:8px;object-fit:contain}
.lightbox-counter{color:#fff;font-size:.9rem;margin-top:12px;opacity:.7}
.lightbox-close{position:absolute;top:20px;right:25px;z-index:3;background:none;border:none;color:#fff;font-size:2.5rem;cursor:pointer;line-height:1;padding:5px 12px}
.lightbox-close:hover{opacity:.7}
.lightbox-prev,.lightbox-next{position:absolute;top:50%;transform:translateY(-50%);z-index:3;background:rgba(255,255,255,.15);border:none;color:#fff;font-size:2.5rem;cursor:pointer;padding:10px 18px;border-radius:50%;line-height:1;transition:background .2s}
.lightbox-prev:hover,.lightbox-next:hover{background:rgba(255,255,255,.3)}
.lightbox-prev{left:20px}
.lightbox-next{right:20px}
</style>

<script>
(function(){
  var images=[];
  for(var i=1;i<=17;i++) images.push('/assets/images/gallery/'+i+'.jpg');
  var current=0;
  var overlay=document.getElementById('lightbox');
  var img=document.getElementById('lightbox-img');
  var counter=document.getElementById('lightbox-counter');

  function show(idx){
    current=idx;
    img.src=images[current];
    counter.textContent=(current+1)+' / '+images.length;
    overlay.style.display='flex';
    document.body.style.overflow='hidden';
  }
  function hide(){
    overlay.style.display='none';
    document.body.style.overflow='';
  }
  function next(){show((current+1)%images.length)}
  function prev(){show((current-1+images.length)%images.length)}

  document.querySelectorAll('.lightbox-trigger').forEach(function(el){
    el.addEventListener('click',function(e){
      e.preventDefault();
      show(parseInt(this.dataset.index));
    });
  });
  document.querySelector('.lightbox-close').addEventListener('click',hide);
  document.querySelector('.lightbox-backdrop').addEventListener('click',hide);
  document.querySelector('.lightbox-next').addEventListener('click',next);
  document.querySelector('.lightbox-prev').addEventListener('click',prev);
  document.addEventListener('keydown',function(e){
    if(overlay.style.display==='none')return;
    if(e.key==='Escape')hide();
    if(e.key==='ArrowRight')next();
    if(e.key==='ArrowLeft')prev();
  });
})();
</script>
